# ─── DISCORD ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_id_here
# Guild ID for instant slash-command registration (leave empty for global deploy)
DISCORD_GUILD_ID=your_guild_id_here
# Channel ID where bot system alerts are sent
DISCORD_ALERT_CHANNEL_ID=your_alert_channel_id_here
# Channel ID for audit log (create/delete/edit commands)
DISCORD_AUDIT_CHANNEL_ID=your_audit_channel_id_here
# Channel where bug/error logs are posted. Leave blank to hard-code
# HARDCODED_LOG_CHANNEL_ID in src/config/index.js instead.
DISCORD_LOG_CHANNEL_ID=your_log_channel_id_here

# ─── ACCESS CONTROL ────────────────────────────────────────────────────────────
# Comma-separated Discord User IDs allowed to use bot commands (no spaces)
ADMIN_USER_IDS=123456789012345678,987654321098765432

# ─── ENCRYPTION ────────────────────────────────────────────────────────────────
# 64-char hex string = 32 bytes for AES-256 key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_ME_WITH_A_RANDOM_64_CHAR_HEX_KEY
# Set OLD_ENCRYPTION_KEY during key rotation to auto-re-encrypt stored passwords
# OLD_ENCRYPTION_KEY=previous_64_char_hex_key_here

# ─── DATABASE (PostgreSQL) ─────────────────────────────────────────────────────
# Ưu tiên dùng 1 connection string duy nhất. Nếu có, biến này sẽ được ưu tiên
# hơn các biến PG* bên dưới. DATABASE_URL không được chứa ssl, sslmode, hoặc
# các tham số TLS khác; hãy cấu hình TLS qua DB_SSL* để không thể tắt xác minh
# chứng chỉ trong URL.
# Định dạng: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://botuser:botpass@localhost:5432/afkbots

# Các biến kết nối rời rạc (chỉ được dùng khi DATABASE_URL để trống):
PGHOST=localhost
PGPORT=5432
PGUSER=botuser
PGPASSWORD=botpass
PGDATABASE=afkbots

# --- Cấu hình SSL/TLS cho kết nối Database ---
# Mọi PostgreSQL không chạy trên loopback (localhost, 127.0.0.0/8, ::1) bắt
# buộc phải dùng TLS đã xác minh. Các cấu hình plaintext hoặc
# rejectUnauthorized=false sẽ khiến ứng dụng dừng khi khởi động.
# Loopback chỉ dành cho phát triển cục bộ; không dùng ngoại lệ này trong production.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Đường dẫn tới CA PEM tin cậy của nhà cung cấp database, ví dụ certs/db-ca.pem.
# Bắt buộc cho mọi database từ xa. File phải tồn tại, đọc được và là PEM hợp lệ.
DB_SSL_CERT_PATH=certs/db-ca.pem

# --- Cấu hình Connection Pool (tinh chỉnh hiệu năng, không bắt buộc) ---
# Số lượng kết nối tối đa được mở đồng thời trong pool
DB_POOL_MAX=10
# Số lượng kết nối tối thiểu luôn được giữ sẵn trong pool (giữ ấm connection)
DB_POOL_MIN=0
# Thời gian (ms) một kết nối idle được giữ trước khi bị đóng lại
DB_POOL_IDLE_TIMEOUT_MS=30000
# Thời gian tối đa (ms) chờ để lấy được một kết nối từ pool trước khi báo lỗi
DB_POOL_CONNECTION_TIMEOUT_MS=10000
# Thời gian tối đa (ms) cho một câu lệnh SQL trước khi tự động bị hủy
# (tránh query "treo" chiếm giữ connection quá lâu)
DB_STATEMENT_TIMEOUT_MS=30000

# ─── WEB DASHBOARD ──────────────────────────────────────────────────────────────
# Same-origin React dashboard and REST/SSE server port
WEB_PORT=8080
# Public protocol mode behind the reverse proxy. false keeps the origin HTTP-compatible.
WEB_HTTPS=false

# ─── STORAGE ───────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_LEVEL=info

# ─── OUTBOUND DESTINATION POLICY ───────────────────────────────────────────────
# Mặc định bot chỉ được kết nối tới địa chỉ IP công khai. Không dùng hostname ở
# đây: mỗi giá trị phải là một literal IPv4/IPv6 riêng lẻ, dùng duy nhất khi cần
# kết nối một Minecraft server private đã được phê duyệt (ví dụ VPN nội bộ).
# MINECRAFT_PRIVATE_DESTINATION_ALLOWLIST=10.42.0.10,fd12:3456::10

# ─── BOT LIMITS ────────────────────────────────────────────────────────────────
MAX_BOTS=50
# Queue size per bot
BOT_QUEUE_SIZE=100
# Queue task timeout in ms
BOT_QUEUE_TIMEOUT=10000
# Discord log summary interval in minutes (10-30)
LOG_SUMMARY_INTERVAL_MIN=15
# Max chunk 2-16
MINECRAFT_VIEW_DISTANCE=4
{
  "name": "EternalGhost-Afk-Bot-Minecraft",
  "version": "4.1.2",
  "description": "Discord-managed multi-Minecraft AFK bot system",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build:web": "npm --prefix web run build",
    "test": "node --test",
    "db:schema": "psql \"$DATABASE_URL\" -f db/schema.sql",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.1"
  }
}
